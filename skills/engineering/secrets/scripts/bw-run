#!/usr/bin/env bash
# bw-run: run `bw` with an unlocked session, so agents never handle a session key.
#
#   bw-run <bw args...>          e.g. bw-run get password <item-id>
#
# Looks for a cached session key in the macOS login Keychain. If it is missing,
# expired or no longer valid, it shows a native macOS dialog (Bitwarden icon,
# "Unlock Bitwarden" button) for the master password, runs `bw unlock`, caches
# the new key for BW_RUN_TTL seconds and then runs `bw` with BW_SESSION set. Neither the master password nor the
# session key is ever printed or passed as an argument.
#
# Environment
#   BW_RUN_TTL      seconds a cached key is reused (default 28800, 8 hours)
#   BW_RUN_TIMEOUT  seconds the dialog waits before giving up (default 90)
#
# Exit codes: bw's own, or 1 for a bw-run failure (dialog cancelled or timed
# out, wrong password, vault signed out, missing tool), 2 for a refused command.
#
# Note: `bw unlock` invalidates every earlier session key, including one
# exported in your own terminal.

set -euo pipefail

SERVICE="bw-run-session"
ACCOUNT="${USER:-$(id -un)}"
TTL="${BW_RUN_TTL:-28800}"
TIMEOUT="${BW_RUN_TIMEOUT:-90}"
LOCKDIR="${TMPDIR:-/tmp}/bw-run-${ACCOUNT}.lock"
SESSION=""

die() { printf 'bw-run: %s\n' "$*" >&2; exit 1; }

[ $# -gt 0 ] || { sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

for arg in "$@"; do
  case "$arg" in
    --session|--session=*)
      printf 'bw-run: refusing --session; bw-run supplies the session itself.\n' >&2
      exit 2 ;;
  esac
done
for arg in "$@"; do
  case "$arg" in
    -*) ;;
    login|logout|unlock|lock|serve|export)
      printf 'bw-run: refusing `bw %s`; run it in your own terminal.\n' "$arg" >&2
      exit 2 ;;
    *) break ;;
  esac
done

command -v bw >/dev/null || die "bw is not installed."
command -v security >/dev/null || die "macOS Keychain (security) is not available; use the request_secret route instead."

load_cache() {
  local entry expiry
  entry="$(security find-generic-password -s "$SERVICE" -a "$ACCOUNT" -w 2>/dev/null)" || return 1
  expiry="${entry%%:*}"
  [[ "$expiry" =~ ^[0-9]+$ ]] && [ "$(date +%s)" -lt "$expiry" ] || return 1
  SESSION="${entry#*:}"
  BW_SESSION="$SESSION" bw unlock --check --nointeraction >/dev/null 2>&1
}

run_bw() {
  release_lock
  BW_SESSION="$SESSION" exec bw --nointeraction "$@"
}

lock_held=0
acquire_lock() {
  local waited=0
  until mkdir "$LOCKDIR" 2>/dev/null; do
    # Steal a lock whose holder has gone.
    local pid
    pid="$(cat "$LOCKDIR/pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      rm -rf "$LOCKDIR"
      continue
    fi
    [ "$waited" -lt $((TIMEOUT + 30)) ] || die "timed out waiting for another bw-run unlock to finish."
    sleep 1
    waited=$((waited + 1))
  done
  lock_held=1
  echo $$ >"$LOCKDIR/pid"
}
release_lock() {
  if [ "$lock_held" = 1 ]; then rm -rf "$LOCKDIR"; lock_held=0; fi
}
trap release_lock EXIT

ask_password() {
  command -v osascript >/dev/null || die "no macOS dialog available (osascript); use the request_secret route instead."
  local icon="/Applications/Bitwarden.app/Contents/Resources/icon.icns" reply
  [ -f "$icon" ] || icon=""
  # The dialog's reply stays inside this process; nothing reaches stdout.
  reply="$(osascript - "Claude wants to run:  bw ${*:1:3}

Enter your Bitwarden master password to unlock the vault for agents for $((TTL / 3600)) hours." \
    "$TIMEOUT" "$icon" 2>/dev/null <<'OSA' || true
on run argv
  set msg to item 1 of argv
  set secs to (item 2 of argv) as integer
  set iconPath to item 3 of argv
  activate
  if iconPath is "" then
    set r to display dialog msg default answer "" with hidden answer with title "Bitwarden unlock for Claude" buttons {"Cancel", "Unlock Bitwarden"} default button "Unlock Bitwarden" cancel button "Cancel" with icon caution giving up after secs
  else
    set r to display dialog msg default answer "" with hidden answer with title "Bitwarden unlock for Claude" buttons {"Cancel", "Unlock Bitwarden"} default button "Unlock Bitwarden" cancel button "Cancel" with icon (POSIX file iconPath) giving up after secs
  end if
  if gave up of r then return "TIMEOUT"
  return "OK:" & (text returned of r)
end run
OSA
)"
  case "$reply" in
    TIMEOUT) die "the password dialog timed out." ;;
    OK:) die "no password entered." ;;
    OK:*) PASSWORD="${reply#OK:}" ;;
    *) die "the password dialog was cancelled." ;;
  esac
}

store_cache() {
  local expiry=$(( $(date +%s) + TTL ))
  # Fed on stdin so the key never appears in the process list.
  printf 'add-generic-password -U -s %s -a %s -l %s -w %s\n' \
    "$SERVICE" "$ACCOUNT" "$SERVICE" "$expiry:$SESSION" | security -i >/dev/null 2>&1 \
    || printf 'bw-run: could not cache the session in Keychain; you will be asked again next time.\n' >&2
}

if load_cache; then run_bw "$@"; fi

status="$(bw status --nointeraction 2>/dev/null | grep -o '"status":"[a-z]*"' | cut -d'"' -f4 || true)"
[ "$status" != "unauthenticated" ] || die "Bitwarden CLI is signed out. Run \`bw login\` in your own terminal first."

acquire_lock
# Another bw-run may have unlocked while this one waited.
if load_cache; then run_bw "$@"; fi

PASSWORD=""
ask_password "$@"
errfile="$(mktemp)"
rc=0
out="$(bw unlock --raw --nointeraction --passwordfile /dev/fd/3 3< <(printf '%s\n' "$PASSWORD") 2>"$errfile")" || rc=$?
PASSWORD=""
# stderr only carries bw's error text; the key goes to stdout.
err="$(grep -v '^[[:space:]]*$' "$errfile" | tail -n1 || true)"
rm -f "$errfile"
[ "$rc" = 0 ] || die "bw unlock failed: ${err:-exit $rc}"
# The key is the last line; anything before it is bw chatter.
SESSION="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -n1 || true)"
BW_SESSION="$SESSION" bw unlock --check --nointeraction >/dev/null 2>&1 \
  || die "bw unlock succeeded but its session did not validate (output had $(printf '%s\n' "$out" | grep -c .) line(s))."
store_cache
run_bw "$@"
